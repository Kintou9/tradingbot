# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Azure PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Broker: Alpaca ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Broker: Robinhood (optional, via robin_stocks) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Market / Fundamentals Data ---
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# --- Notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- App Config ---
TRADING_MODE=paper
STARTING_CAPITAL=20
MAX_POSITION_PCT=0.5
DAILY_LOSS_LIMIT_PCT=0.10
