# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Azure PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Broker: Alpaca ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Broker: Robinhood (optional, via robin_stocks) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Market / Fundamentals Data ---
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# --- Notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- App Config ---
TRADING_MODE=paper
STARTING_CAPITAL=20
MAX_POSITION_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.02

# --- Dashboard API auth (shared secret between api/main.py and the Electron app) ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_API_TOKEN=

# Shared across manual, primary and swing entries. Exits are exempt.
MAX_TRADE_NOTIONAL=100
MAX_TRADES_PER_DAY=3
MAX_TOTAL_EXPOSURE_PCT=0.30
# Real-money submissions also require an exact account ID and separate DB.
LIVE_TRADING_ENABLED=false
LIVE_ACCOUNT_ID=
ALPACA_DATA_FEED=iex
# HTTPS dead-man-switch URL; configure the remote service to alert after 2 min.
HEARTBEAT_URL=
# Researches Watcher + trading watchlist in batches, independently of trading.
RESEARCH_SCHEDULE_ENABLED=true

# --- Supervised LangGraph workflow (agent/) ---
# Max times the llm_synthesis/validate_synthesis guardrail loop retries
# before terminating the run without a trade (see agent/nodes.py).
LLM_SYNTHESIS_MAX_RETRIES=2
